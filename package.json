{
  "name": "sabeel-institute-time-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute Time Tracker — hours tracking for a small nonprofit (Android, iPhone and web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared && sabeel-ci build-info",
    "lint": "eslint . && npm run check:text && npm run check:version",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "sabeel-ci test-emulator",
    "test:e2e": "node scripts/web-e2e.mjs",
    "test:screens": "node scripts/screens-e2e.mjs",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "knip": "knip",
    "verify": "npm run lint && npm run typecheck && npm run knip && npm test",
    "check:text": "sabeel-ci check-text-sources",
    "check:version": "sabeel-ci check-version",
    "build:aab": "sabeel-ci build-aab",
    "check:ios": "sabeel-ci check-ios-config",
    "build:ios": "sabeel-ci build-ios",
    "check:push": "sabeel-ci check-push",
    "check:web-push": "sabeel-ci check-web-push",
    "emulators": "sabeel-ci emulators",
    "emulators:free": "sabeel-ci free-emulator-ports"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sabeel-institute/ci-tools": "github:Sabeel-Institute/ci-tools#42638d62beb71a192245c3e067b0000f2d5ca324",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
