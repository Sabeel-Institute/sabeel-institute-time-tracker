{
  "name": "sabeel-institute-time-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute Time Tracker — hours tracking for a small nonprofit (Android, iPhone and web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared && node scripts/gen-build-info.mjs",
    "lint": "eslint . && npm run check:text && npm run check:version",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "bash scripts/test-emulator.sh",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "knip": "knip",
    "check:text": "node scripts/check-text-sources.mjs",
    "test:e2e": "node scripts/web-e2e.mjs",
    "test:screens": "node scripts/screens-e2e.mjs",
    "emulators:free": "bash scripts/free-emulator-ports.sh",
    "release": "node scripts/release.mjs",
    "publish:play": "node scripts/publish-play.mjs",
    "verify": "npm run lint && npm run typecheck && npm run knip && npm test",
    "check:version": "node scripts/check-version.mjs",
    "check:ios": "node scripts/check-ios-config.mjs",
    "build:ios": "bash scripts/build-ios.sh",
    "check:web-push": "node scripts/check-web-push.mjs",
    "check:push": "node scripts/check-push.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "knip": "^5.88.1"
  }
}
