{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --dir test/unit",
    "test:emulator:rules": "vitest run --dir test/integration --no-file-parallelism",
    "test:emulator:functions": "vitest run --dir test/gate --no-file-parallelism",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.5.1",
    "@sentry/node": "^11.8.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.28.2",
    "firebase": "^12.15.0",
    "vitest": "^4.1.11"
  }
}
