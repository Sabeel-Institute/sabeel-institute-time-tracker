# Function parameters for the emulators' demo project. Present so the functions
# emulator never stops to prompt for a value: the emulated functions send no push
# (functions/src/messaging.ts, emulatorSender), so these are never used.
APNS_KEY_ID=unused-in-emulator
APPLE_TEAM_ID=unused-in-emulator
# The emulated reportProblem sends no email (functions/src/reportProblem.ts,
# emulatorMailer), so the signing service account is never used either.
REPORT_MAILER_SA=unused-in-emulator
