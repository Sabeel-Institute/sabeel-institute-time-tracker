rules_version = '2';

// Deny-by-default. The backend (Cloud Functions, admin SDK) bypasses all rules;
// clients get only the narrow, explicitly-allowed paths below.
//
// Roles live in custom claims (`role`, `status`, `admin`), set exclusively by the
// setUserAccess callable. The user doc mirrors them for UI display; the token is
// what rules trust.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with an email and a password rather than Google. One account
    // may do that: PASSWORD_ACCOUNT_EMAIL in @sabeel/shared, restated in
    // isSignedIn below (functions/test/unit/signInGate.test.ts holds the two
    // equal). A password session for any other address is treated as signed
    // out, and a password session is never a manager or an admin, whatever its
    // claims say. The callables apply the same two locks (functions/src/auth.ts).
    function isPasswordSession() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password';
    }
    function isSignedIn() {
      return request.auth != null
        && (!isPasswordSession() || request.auth.token.get('email', '') == 'app-review@oursabeel.com');
    }
    function isActive() {
      return isSignedIn() && request.auth.token.get('status', '') == 'active';
    }
    function isManager() {
      return isActive() && !isPasswordSession() && request.auth.token.get('role', '') == 'manager';
    }
    // Only admins approve users / change roles; they need to read profiles
    // (name, email) to do it, even if they aren't managers themselves.
    function isAdmin() {
      return isActive() && !isPasswordSession() && request.auth.token.get('admin', false) == true;
    }

    // ---- Timesheet periods (Sun–Sat weeks clipped to month boundaries) ----
    // Mirrors periodKeyFor in @sabeel/shared/src/time.ts — recomputed here so a
    // client cannot stamp a false periodKey to dodge a submitted/approved lock.

    // 0=Sunday…6=Saturday. Epoch day 0 (1970-01-01) was a Thursday (Sun0 index 4).
    function dowSun0(y, m, d) {
      return (timestamp.date(y, m, d).toMillis() / 86400000 + 4) % 7;
    }
    // Canonical period start for a dayKey: the Sunday on or before it, clipped to
    // the 1st of its month. A clipped period never crosses a month boundary, so
    // the result stays in dayKey's own year-month.
    function periodKeyOf(dayKey) {
      let p = dayKey.split('-');
      let dd = int(p[2]);
      let s0 = dd - dowSun0(int(p[0]), int(p[1]), dd);
      let s = s0 < 1 ? 1 : s0;
      return p[0] + '-' + p[1] + '-' + (s < 10 ? '0' + string(s) : string(s));
    }

    // ---- Timesheet state → who may touch a period's entries ----
    function tsPath(uid, periodKey) {
      return /databases/$(database)/documents/timesheets/$(uid + '_' + periodKey);
    }
    // 'draft' while no timesheet doc exists (the user simply hasn't submitted).
    function periodStatus(uid, periodKey) {
      return exists(tsPath(uid, periodKey)) ? get(tsPath(uid, periodKey)).data.status : 'draft';
    }
    // draft/rejected: owner or any manager/admin (managers may correct AND add on
    // behalf). submitted: only the stamped approver or an admin — never the owner
    // (they withdraw first). approved: nobody (an admin reopens first).
    function canTouchPeriod(entryUid, periodKey) {
      let st = periodStatus(entryUid, periodKey);
      return (st == 'draft' || st == 'rejected')
        ? (request.auth.uid == entryUid || isManager() || isAdmin())
        : (st == 'submitted'
            && request.auth.uid != entryUid
            && (isAdmin() || get(tsPath(entryUid, periodKey)).data.approverUid == request.auth.uid));
    }

    // approverUid may be null (unset) or point at an active manager-or-admin.
    function approverOk(av) {
      return av == null
        || (get(/databases/$(database)/documents/users/$(av)).data.status == 'active'
            && (get(/databases/$(database)/documents/users/$(av)).data.role == 'manager'
                || get(/databases/$(database)/documents/users/$(av)).data.admin == true));
    }

    match /users/{uid} {
      // Accounts are provisioned server-side by the onUserCreate trigger (it sets
      // pending claims + creates the doc, or deletes a non-org account) — the
      // client never creates its own profile. role/status/admin changes only via
      // setUserAccess. The domain gate lives once, in the trigger (shared
      // isAllowedEmail); there is no client-create path to guard here.
      allow create: if false;
      // Everyone active may read manager/admin profiles — users must see the
      // list of possible approvers to pick theirs (queries filter on role/admin).
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isManager() || isAdmin()
            || (isActive() && resource != null
                && (resource.data.role == 'manager' || resource.data.admin == true)));
      // Self may touch the clock pointer, cosmetic profile fields, their own
      // approver choice (must be an active manager/admin, or null), notification
      // prefs, and last-seen timezone. NOT lastReminderDayKey — that dedup
      // marker is server-written only.
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeEntryId', 'displayName', 'photoURL', 'approverUid',
                       'notifPrefs', 'timeZone'])
        // Cosmetic fields are still typed and bounded. This cannot stop someone
        // choosing a name that collides with a colleague's — names legitimately
        // collide — but reports and the CSV carry the email alongside, so a
        // display name is never the identifier anything is decided on.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() > 0
                && request.resource.data.displayName.size() <= 100))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL'])
            || request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string
                && request.resource.data.photoURL.size() <= 2000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['approverUid'])
            || approverOk(request.resource.data.approverUid))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['notifPrefs'])
            || request.resource.data.notifPrefs is map)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timeZone'])
            || request.resource.data.timeZone is string);
      // Cross-user: managers assign any non-admin's approver; admins anyone's.
      // Nothing else — status/role/admin changes only via setUserAccess.
      allow update: if isActive() && request.auth.uid != uid
        && (isAdmin() || (isManager() && resource.data.admin != true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approverUid'])
        && approverOk(request.resource.data.approverUid);
      allow delete: if false;

      // Push registration tokens: strictly the owner's business. The server
      // (admin SDK) reads them to send and prunes dead ones.
      // Registering requires an ACTIVE account (a pending/disabled user has no
      // reason to receive anything). Read/delete stay at merely signed-in on
      // purpose: sign-out deregisters this device, and that cleanup must still
      // work for someone who was disabled while signed in — otherwise their
      // tokens linger and the next person on the device inherits them.
      //
      // Exactly two shapes (PushTokenDoc in @sabeel/shared). A browser or an
      // Android phone holds an FCM token. An iPhone holds Apple's own token and
      // says which of Apple's two services issued it, because the server must
      // send to that one and the other refuses it (functions/src/apns.ts). The
      // doc id IS the token, which is the address the server sends to. `hasOnly`
      // because this row is read by the send path, and a field nobody expects
      // is a field nobody validates.
      match /pushTokens/{tokenId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isActive() && request.auth.uid == uid
          && request.resource.data.token == tokenId
          && request.resource.data.updatedAt is int
          && (
            (request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
              && request.resource.data.platform in ['web', 'android'])
            || (request.resource.data.keys().hasOnly(['token', 'platform', 'apnsEnvironment', 'updatedAt'])
              && request.resource.data.platform == 'ios'
              && request.resource.data.apnsEnvironment in ['development', 'production'])
          );
      }
    }

    // Activities hours are assigned to. Any active user picks from
    // them; only managers shape the list. Never deleted — archived (status flip),
    // so historical entries keep a valid reference.
    match /activities/{activityId} {
      function activityValid(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 200
          && d.status in ['active', 'archived'];
      }
      allow read: if isActive();
      allow create: if (isManager() || isAdmin()) && activityValid(request.resource.data);
      // The same validation on update — checking only `status` would have let an
      // archive/restore blank the name or rewrite the provenance fields. The UI
      // only ever sends `status`; this is the surface, not the caller, agreeing.
      allow update: if (isManager() || isAdmin())
        && activityValid(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }

    // Hours. Entries are logged freely into a period while it is in draft (or
    // rejected); once its timesheet is submitted the owner is locked out (the
    // stamped approver / admins may still correct or add); approved periods are
    // immutable until an admin reopens. All times are epoch-ms numbers;
    // timeZone/dayKey pin the entry to the local day the work happened, and
    // periodKey pins it to its Sun–Sat month-clipped timesheet period.
    match /timeEntries/{entryId} {
      // A dayKey is derived from `start` in the entry's own timezone, which rules
      // cannot recompute (there is no tz database here). What they CAN do is bound
      // it: every real UTC offset lies in [-12h, +14h], so the instant behind local
      // day D must fall in [D_utc - 14h, D_utc + 36h). Outside that the entry is
      // incoherent — the day a report files it under would contradict the times
      // printed on it. Deliberately loose; it catches gross mismatches, not
      // off-by-an-hour ones, and no honest client can trip it.
      function dayKeyPlausible(dayKey, start) {
        let p = dayKey.split('-');
        let dayMs = timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis();
        return start >= dayMs - 14 * 3600000 && start < dayMs + 36 * 3600000;
      }
      function entryValid(d) {
        return d.uid is string && d.uid.size() > 0
          && d.activityId is string && d.activityId.size() > 0
          && d.activityName is string && d.activityName.size() > 0
          && d.start is int && d.start > 0
          && d.timeZone is string && d.timeZone.size() > 0
          && d.dayKey is string && d.dayKey.size() == 10
          && d.periodKey == periodKeyOf(d.dayKey)
          && dayKeyPlausible(d.dayKey, d.start)
          && d.source in ['clock', 'manual']
          && (d.end == null
              ? !('durationMinutes' in d)
              : (d.end is int && d.end > d.start
                 && d.durationMinutes is int
                 && d.durationMinutes > 0
                 && d.durationMinutes <= 24 * 60
                 // Tie the reported minutes to the actual span so a client
                 // can't inflate hours independently of the times. Upper bound
                 // only, +1 to absorb the client's Math.round and 1-min floor.
                 && d.durationMinutes <= (d.end - d.start) / 60000 + 1));
      }
      function me() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function meAfter() {
        return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      // resource == null: reading a doc that doesn't exist (yet) is allowed —
      // the clock-in listener attaches optimistically before the server ack,
      // and IDs are unguessable so existence probing is moot.
      allow read: if isActive()
        && (resource == null || resource.data.uid == request.auth.uid
            || isManager() || isAdmin());

      // Owner creates their own entries (a running clock-in must, in the same
      // batch, point users/{uid}.activeEntryId at itself, and only when no other
      // session runs). Managers/approvers create CLOSED entries on behalf of
      // others, flagged with lastEditedBy — who may do so per period state is
      // canTouchPeriod's call (submitted → stamped approver/admin only).
      // Referential integrity is checked on CREATE only: an existing entry's
      // references were validated when it was written, activities are never
      // deleted, and re-reading both docs on every clock-out would be waste.
      allow create: if isActive()
        && entryValid(request.resource.data)
        && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && canTouchPeriod(request.resource.data.uid, request.resource.data.periodKey)
        && (
          (request.resource.data.uid == request.auth.uid
            && (request.resource.data.end != null
                || (me().activeEntryId == null && meAfter().activeEntryId == entryId)))
          ||
          (request.resource.data.uid != request.auth.uid
            && request.resource.data.end != null
            && request.resource.data.lastEditedBy == request.auth.uid)
        );

      // Carve-out first: the owner may ALWAYS close their own running entry
      // (clock-out must never be bricked by a period submitted mid-session),
      // clearing the pointer in the same batch and touching nothing else.
      // Every other edit must clear BOTH the source and target period locks —
      // an edit can move an entry between periods by changing its dayKey.
      allow update: if isActive()
        && request.resource.data.uid == resource.data.uid
        && entryValid(request.resource.data)
        && (
          (resource.data.uid == request.auth.uid
            && resource.data.end == null
            && request.resource.data.end != null
            && meAfter().activeEntryId == null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['end', 'durationMinutes', 'updatedAt']))
          ||
          (canTouchPeriod(resource.data.uid, resource.data.periodKey)
            && canTouchPeriod(resource.data.uid, request.resource.data.periodKey)
            && (
              (resource.data.uid == request.auth.uid
                && (resource.data.end != null || request.resource.data.end == null
                    || meAfter().activeEntryId == null))
              ||
              (resource.data.uid != request.auth.uid
                && resource.data.end != null && request.resource.data.end != null
                && request.resource.data.lastEditedBy == request.auth.uid)
            ))
        );

      // Deletes go through the period lock; closed entries by owner or (per
      // canTouchPeriod) managers/approver, a running entry only by its owner,
      // clearing the pointer in the same batch.
      allow delete: if isActive()
        && canTouchPeriod(resource.data.uid, resource.data.periodKey)
        && (resource.data.end != null
            || (resource.data.uid == request.auth.uid && meAfter().activeEntryId == null));
    }

    // Operational state written only by the backend (the health canary's
    // document-count baseline). Deny-by-default would already cover it; stated
    // explicitly so the server-only intent is visible on the security surface.
    match /meta/{docId} {
      allow read, write: if false;
    }

    // Append-only timesheet history, written by the onTimesheetWritten trigger.
    // Server-only for the same reason it exists: submit/approve/reject/withdraw/
    // reopen all mutate (or delete) the single timesheet doc, so without this the
    // record of who approved a period — and that it was later reopened — is gone.
    // A client that could write here could forge that record; a client that could
    // read it gains nothing the app doesn't already show.
    match /timesheetEvents/{eventId} {
      allow read, write: if false;
    }

    // Weekly timesheets: one doc per (user, period) from submission on; no doc =
    // draft. Lifecycle: submit (owner create) → approve/reject (stamped approver
    // or admin) → resubmit after rejection (owner). Withdraw = owner delete while
    // not approved; admin delete reopens anything back to draft.
    match /timesheets/{tsId} {
      function tsValid(d) {
        return d.uid is string && d.uid.size() > 0
          && tsId == d.uid + '_' + d.periodKey
          && d.periodKey is string && d.periodKey.size() == 10
          && d.periodKey == periodKeyOf(d.periodKey)
          && d.toKey is string && d.toKey.size() == 10
          && d.toKey >= d.periodKey
          && periodKeyOf(d.toKey) == d.periodKey
          && d.status in ['submitted', 'approved', 'rejected']
          && d.approverUid is string && d.approverUid.size() > 0
          && d.submittedAt is int
          && d.totalMinutes is int && d.totalMinutes >= 0
          && d.entryCount is int && d.entryCount >= 0;
      }
      // The approver is stamped from the submitter's CURRENT profile value.
      // Self-approval is deliberate policy at this org size: approverOk accepts
      // any active manager/admin including oneself, so a manager may choose
      // themselves; admins may stamp themselves without having chosen it (top of
      // the chain). See PRODUCTION-REVIEW M5.
      function stampOk(d) {
        return d.approverUid ==
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approverUid
          || (isAdmin() && d.approverUid == request.auth.uid);
      }
      // No future periods. Rules can't format request.time into a local dayKey,
      // so allow UTC+14 slack; the client enforces the device-local boundary.
      function periodStarted(d) {
        let p = d.periodKey.split('-');
        return timestamp.date(int(p[0]), int(p[1]), int(p[2])).toMillis()
          <= request.time.toMillis() + 14 * 3600000;
      }

      // Owners and the stamped approver see their sheets; managers see all
      // (reports/queues). resource == null covers listeners on the deterministic
      // id before submission — only for one's own sheets.
      allow read: if isActive()
        && (resource == null
            ? (tsId.split('_')[0] == request.auth.uid || isManager() || isAdmin())
            : (resource.data.uid == request.auth.uid
               || resource.data.approverUid == request.auth.uid
               || isManager() || isAdmin()));

      // SUBMIT (draft → submitted): owner only; zero-hour allowed.
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && tsValid(request.resource.data)
        && request.resource.data.status == 'submitted'
        && stampOk(request.resource.data)
        && periodStarted(request.resource.data)
        && !('decidedAt' in request.resource.data)
        && !('decidedBy' in request.resource.data)
        && !('rejectReason' in request.resource.data);

      allow update: if isActive()
        && tsValid(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.periodKey == resource.data.periodKey
        && (
          // RESUBMIT (rejected → submitted): owner re-stamps their current
          // approver and the decision fields are cleared.
          (resource.data.uid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'submitted'
            && stampOk(request.resource.data)
            && !('decidedAt' in request.resource.data)
            && !('decidedBy' in request.resource.data)
            && !('rejectReason' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'approverUid', 'submittedAt', 'totalMinutes',
                  'entryCount', 'updatedAt', 'decidedAt', 'decidedBy', 'rejectReason']))
          ||
          // DECIDE (submitted → approved | rejected): the stamped approver,
          // revalidated as a CURRENT manager, or any admin; rejections carry a
          // reason, approvals don't. The role re-check matters because a stamp is
          // written once and never revisited afterwards — without it a manager who
          // was demoted or disabled would keep deciding (their own sheets included,
          // now that self-approval is allowed) for as long as the stamp survived.
          // applyUserAccess clears dangling pointers when eligibility is lost; this
          // is the braces to that belt, on the surface that actually enforces.
          (resource.data.status == 'submitted'
            && (isAdmin() || (isManager() && resource.data.approverUid == request.auth.uid))
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.decidedAt is int
            && (request.resource.data.status == 'approved'
                  ? !('rejectReason' in request.resource.data)
                  : (request.resource.data.rejectReason is string
                     && request.resource.data.rejectReason.size() > 0))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'decidedAt', 'decidedBy', 'rejectReason',
                  'totalMinutes', 'entryCount', 'updatedAt']))
        );

      // WITHDRAW (owner, before approval) and REOPEN (admin, any state).
      allow delete: if isActive()
        && ((resource.data.uid == request.auth.uid && resource.data.status != 'approved')
            || isAdmin());
    }
  }
}
