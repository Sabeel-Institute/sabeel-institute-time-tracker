# Dependencies
node_modules/

# Builds
packages/shared/lib/
functions/lib/
app/dist-web/
app/.expo/
# Generated by `expo prebuild --platform ios` on every build (scripts/build-ios.sh).
# The pods it resolves are pinned by the committed app/Podfile.lock instead.
app/ios/
build/
# Metro's transform cache, moved in-repo so `--clear` cannot delete a sibling
# project's cache out from under it (see app/metro.config.js).
app/.metro-cache/
# Generated at build time by scripts/gen-build-info.mjs (version + git hash).
app/src/build-info.ts

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Env / local secrets (client DSNs etc. — names only in docs/SECRETS.md)
.env
.env.local
*.local.env
functions/.env
# The Sentry auth token the native build uploads source maps with.
app/.env.sentry-build-plugin
# e2e artifacts
e2e-shots/
app/dist-web/

# Logs & misc
*.log
.DS_Store
e2e-shots/
app/android/sentry.properties
build-artifacts
gha-creds-*.json
app/android/keystore.properties
