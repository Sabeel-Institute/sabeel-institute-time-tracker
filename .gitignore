# Dependencies
node_modules/

# Builds
packages/shared/lib/
functions/lib/
app/dist-web/
app/.expo/
# Generated by `expo prebuild --platform ios` on every build (`sabeel-ci build-ios`).
# The pods it resolves are pinned by the committed app/Podfile.lock instead.
app/ios/
build/
# Metro's transform cache, moved in-repo so `--clear` cannot delete a sibling
# project's cache out from under it (see app/metro.config.js).
app/.metro-cache/
# Generated at build time by `sabeel-ci build-info` (version + git hash).
app/src/build-info.ts

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Env / local secrets (client DSNs etc. — names only in docs/SECRETS.md)
.env
.env.local
*.local.env
functions/.env
# The Sentry auth token the native build uploads source maps with.
app/.env.sentry-build-plugin
# Sentry's Android tooling reads a token from it; any old copy stays out of Git.
app/android/sentry.properties
# Screenshots and logs of the browser and device suites
shots/

# Signing keys and service-account keys: never in a public repository. The
# debug keystore is public by design (every Android SDK ships the same one).
*.jks
*.keystore
!app/android/app/debug.keystore
*service-account*.json
*firebase-adminsdk*.json
app/android/keystore.properties

# Logs & misc
*.log
.DS_Store
build-artifacts
gha-creds-*.json
# native-e2e copies ci-tools' shared flow steps here for each run
maestro/ci-tools/
