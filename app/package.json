{
  "name": "@sabeel/app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../scripts/preflight-metro.mjs && expo start",
    "android": "node ../scripts/preflight-metro.mjs && expo run:android",
    "web": "expo start --web",
    "web:export": "node ../scripts/check-version.mjs && node ../scripts/gen-build-info.mjs && expo export --platform web --output-dir dist-web --clear",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@sabeel/shared": "*",
    "@sentry/react": "^10.66.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.4",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~58.0.11",
    "expo-notifications": "~57.0.6",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
